   "pattern_src": "\\bgit\\s+push\\s+{ARGS}-(?!-)[a-z]*f[a-z]*(?=[\\s;&|)`]|$)",
   "reason": "git push -f (use --force-with-lease)",
   "anchored": true
  },
  {
