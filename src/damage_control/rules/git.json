{
 "bashToolPatterns": [
  {
   "id": "git.git-reset-hard-use-soft-or-stash",
   "pattern": "\\bgit\\s+reset\\s+(?:(?!--(?:\\s|$))[^\\s;&|]+\\s+)*?--hard\\b",
   "pattern_src": "\\bgit\\s+reset\\s+{ARGS}--hard\\b",
   "reason": "git reset --hard (use --soft or stash)",
   "anchored": true
  },
  {
   "id": "git.git-clean-with-force-directory-flags",
   "pattern": "\\bgit\\s+clean\\s+(?!(?:[^;&|]*\\s)?(?:-(?!-)[a-z]*n[a-z]*(?=[\\s;&|)`]|$)|--d[a-z-]*))(?:(?!--(?:\\s|$))[^\\s;&|]+\\s+)*?(?:-(?!-)[a-z]*[fd][a-z]*|--force)(?=[\\s;&|)`]|$)",
   "pattern_src": "\\bgit\\s+clean\\s+(?!(?:[^;&|]*\\s)?(?:-(?!-)[a-z]*n[a-z]*(?=[\\s;&|)`]|$)|--d[a-z-]*)){ARGS}(?:-(?!-)[a-z]*[fd][a-z]*|--force)(?=[\\s;&|)`]|$)",
   "reason": "git clean with force/directory flags",
   "anchored": true
  },
  {
   "id": "git.git-push-force-use-force-with-lease",
