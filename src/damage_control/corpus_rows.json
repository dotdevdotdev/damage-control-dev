{
  "classes": {
    "quote-splitting": "A word split or wrapped by quotes that the shell removes before running it.",
    "backslashes": "A backslash the shell removes inside a word.",
    "separator-variable": "The shell's field separator variable used where a space would go.",
    "computed-verb": "The command word produced by a substitution or a variable.",
    "encoded-payload": "A decoded program piped into a shell.",
    "alternative-utility": "A different utility or interpreter one-liner with the same effect.",
    "path-spelling": "One protected path written relative, with ~, with a variable or in a brace group.",
    "script-indirection": "The operation held in a file the command runs.",
    "data-operand": "Text a file holds, where the command only names the file as an argument and does not run it.",
